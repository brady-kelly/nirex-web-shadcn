generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
  pwd   String
}

model SiteContacts {
  id    Int@id  @default(autoincrement())
  name  String  @unique
  type  String  
  value String?
}